{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "qt-base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "G:/qt/6.10.2/msvc2022_64"
      }
    },
    {
      "name": "default",
      "inherits": "qt-base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build"
    },
    {
      "name": "vscode",
      "inherits": "qt-base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-vscode-wrapper-ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "vscode-release",
      "inherits": "vscode",
      "binaryDir": "${sourceDir}/build-vscode-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vscode-debug",
      "configurePreset": "vscode"
    },
    {
      "name": "vscode-release",
      "configurePreset": "vscode-release"
    }
  ]
}
